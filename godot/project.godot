; 한 접시의 바다 · 고닷 4.7 프로젝트 설정
; 에디터가 다시 쓰면 순서가 바뀔 수 있다

config_version=5

[application]

config/name="한 접시의 바다"
config/version="0.3.0"
run/main_scene="res://scenes/core_lab.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.105882, 0.164706, 0.254902, 1)

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="Hanjeopsi"

[gui]

theme/custom_font="res://fonts/GowunDodum-Regular.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
