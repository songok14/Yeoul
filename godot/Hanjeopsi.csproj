<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!-- 고닷 쪽 코드(화면, 입력, 연출). 게임 규칙은 core/Hanjeopsi.Core 에 있다 -->
  <PropertyGroup>
    <!-- 고닷 4.7 안드로이드 C# 템플릿은 net9.0 만 받는다 -->
    <TargetFramework>net9.0</TargetFramework>
    <!-- .NET 9 SDK 가 없는 곳(Claude 작업 환경)에서 점검 컴파일할 때: -p:HanjeopsiNet8=true -->
    <TargetFramework Condition=" '$(HanjeopsiNet8)' == 'true' ">net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Hanjeopsi.App</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../core/Hanjeopsi.Core/Hanjeopsi.Core.csproj" />
  </ItemGroup>
</Project>
