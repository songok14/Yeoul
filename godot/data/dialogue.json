  "scenes": {
    "welcome": [
      {
        "speaker": "yeoul",
        "face": "journal",
        "text": "내 손으로 낚은 물고기라면.\n어쩌면 맛을 되찾을 수 있을지도 모른다."
      },
      {
        "speaker": "yeoul",
        "face": "default",
        "text": "4주 동안 매주 나눠 갚는다.\n일단 방파제부터 가 보자."
      }
    ],
    "chapterClear": [
      {
        "speaker": "yeoul",
        "face": "cheer",
        "text": "1차 상환금 300만 원을 모두 갚았다!"
      },
      {
        "speaker": "grandma",
        "face": "stew",
        "text": "(말없이 볼락구이 한 접시를 내민다)"
      },
      {
        "speaker": "yeoul",
        "face": "saltyTear",
        "text": "이번엔 짠맛 말고 다른 맛도 조금 났다."
      }
    ],
    "chapterFail": [
      {
        "speaker": "",
        "face": "",
        "text": "상환일을 또 넘겼다.\n할머니댁 문에 빨간 딱지가 붙었다."
      },
      {
        "speaker": "yeoul",
        "face": "knees",
        "text": "할머니는 괜찮다고 했다.\n괜찮지 않다는 걸 나는 맛이 아니라 얼굴로 알았다."
      },
      {
        "speaker": "yeoul",
        "face": "default",
        "text": "아직 바다에는 물고기가 있다.\n처음부터 다시 해 보자."
      }
    ],
    "catFloat": [
      {
        "speaker": "",
        "face": "",
        "text": "고등어가 발치에 와서 몸을 비빈다.\n목에 뭔가 달랑거린다."
      },
      {
        "speaker": "yeoul",
        "face": "default",
        "text": "찌잖아? 손으로 깎은 나무 찌네."
      },
      {
        "speaker": "",
        "face": "",
        "text": "낡은 찌 아래에 칼로 새긴 글씨가 있다.\nD.Y."
      },
      {
        "speaker": "yeoul",
        "face": "journal",
        "text": "D.Y....\n어디서 본 글씨 같은데."
      }
    ],
    "nossiNote": [
      {
        "speaker": "",
        "face": "",
        "text": "미끼가게 문틈에 쪽지가 끼워져 있다."
      },
      {
        "speaker": "",
        "face": "",
        "text": "「고양이 우는 쪽으로 던져라.」"
      },
      {
        "speaker": "yeoul",
        "face": "default",
        "text": "노씨 아저씨 글씨다.\n말로 하시면 될 텐데."
      }
    ],
    "seraMeet": [
      {
        "speaker": "",
        "face": "",
        "text": "방파제 입구에 파란 승합차가 섰다.\n옆구리에 블루훅 로고가 번쩍인다."
      },
      {
        "name": "차세라",
        "text": "여기가 물비늘포구나.\n사진보다 작네."
      },
      {
        "speaker": "yeoul",
        "face": "nervous",
        "text": "누구세요?"
      },
      {
        "name": "차세라",
        "text": "블루훅 차세라.\n이 방파제 곧 우리 리조트 자리야."
      },
      {
        "name": "차세라",
        "text": "20일에 다시 올게.\n40cm 넘는 걸 낚으면 인정해 줄게."
      },
      {
        "speaker": "yeoul",
        "face": "default",
        "text": "인정은 필요 없어요.\n아빠가 그랬거든요."
      },
      {
        "speaker": "yeoul",
        "face": "journal",
        "text": "고기는 먼저 낚은 사람 게 아니야. 제일 맛있게 먹어주는 사람 거지."
      }
    ],
    "seraDuel": [
      {
        "name": "차세라",
        "text": "약속대로 왔어.\n오늘 안에 40cm. 못 넘으면 구경만 해."
      },
      {
        "speaker": "yeoul",
        "face": "default",
        "text": "오늘 저녁 메뉴 걸고 낚을게요."
      }
    ]
